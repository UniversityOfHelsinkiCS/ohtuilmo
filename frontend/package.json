{
  "name": "ohtuilmo-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test-setup": "npm run test-setup:down && docker compose -f ../compose.local-test.yaml --profile local-e2e up -d",
    "test-setup:down": "docker compose -f ../compose.local-test.yaml --profile local-e2e down",
    "test:docker": "docker compose -f ../compose.local-test.yaml --profile e2e up --force-recreate --exit-code-from cypress",
    "test:docker:down": "docker compose -f ../compose.local-test.yaml --profile e2e down",
    "test": "CYPRESS_baseUrl=http://localhost:5000 npx cypress open",
    "test:headless": "CYPRESS_VIDEO=false CYPRESS_baseUrl=http://localhost:5000 npx cypress run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.2.4",
    "@dnd-kit/react": "^0.2.4",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/styles": "^6.4.8",
    "@mui/x-date-pickers": "^9.11.0",
    "axios": "^1.19.0",
    "dayjs": "^1.11.21",
    "history": "^5.3.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.2",
    "react-select": "^5.10.2",
    "recharts": "^3.10.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "cypress": "^15.19.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "vite": "^5.4.21"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "engines": {
    "node": "24"
  }
}
